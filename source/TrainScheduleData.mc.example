// Train Schedule Data
// This file contains the timetable data for the TrainSchedule-Finder app.
// 
// Data structure is the 2 dimension list such as [[hhmm(int), traintype(int)],...].
// - hhmm: departure time in 24-hour format (e.g., 514 = 05:14, 1200 = 12:00)
// - traintype: 0 = local train (black), 1 = express train (green), 2 = special (red)
//
// Example: [[0845,0],[0851,1],...,[2359,0]]
//
// Outbound tables (weekday_table, holiday_table): Schedule from home to destination
// Return tables (weekday_return_table, holiday_return_table): Schedule from destination to home
// Swipe left/right on the watch to toggle between outbound and return schedules.

module TrainScheduleData {
    // Outbound schedules (home -> destination)
    var weekday_table = [[514,0],[628,1],[655,0],[745,1],[815,0],[900,1],[930,0],[1015,1],[1045,0],[1130,1],[1200,0],[1245,1],[1315,0],[1400,1],[1430,0],[1515,1],[1545,0],[1630,1],[1700,0],[1745,1],[1815,0],[1900,1],[1930,0],[2015,1],[2045,0],[2130,1],[2200,0],[2245,1],[2315,0],[2400,1],[2430,2]];
    var holiday_table = [[514,0],[628,1],[655,0],[745,1],[815,0],[900,1],[930,0],[1015,1],[1045,0],[1130,1],[1200,0],[1245,1],[1315,0],[1400,1],[1430,0],[1500,1],[1530,0],[1630,1],[1700,0],[1745,1],[1815,0],[1900,1],[1930,0],[2015,1],[2045,0],[2130,1],[2200,0],[2245,1],[2315,0],[2400,1],[2430,2]];

    // Return schedules (destination -> home)
    var weekday_return_table = [[530,0],[645,1],[715,0],[800,1],[830,0],[915,1],[945,0],[1030,1],[1100,0],[1145,1],[1215,0],[1300,1],[1330,0],[1415,1],[1445,0],[1530,1],[1600,0],[1645,1],[1715,0],[1800,1],[1830,0],[1915,1],[1945,0],[2030,1],[2100,0],[2145,1],[2215,0],[2300,1],[2330,0],[2415,1],[2445,2]];
    var holiday_return_table = [[530,0],[645,1],[715,0],[800,1],[830,0],[915,1],[945,0],[1030,1],[1100,0],[1145,1],[1215,0],[1300,1],[1330,0],[1415,1],[1445,0],[1515,1],[1545,0],[1645,1],[1715,0],[1800,1],[1830,0],[1915,1],[1945,0],[2030,1],[2100,0],[2145,1],[2215,0],[2300,1],[2330,0],[2415,1],[2445,2]];
}
